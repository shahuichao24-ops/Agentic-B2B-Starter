# ==============================================================================
# B2B SaaS Backend Configuration Example
# ==============================================================================

# Project Name
PROJECT_NAME="Agentic B2B SaaS Platform"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Database Connection (Default SQLite for local dev, or PostgreSQL for production)
DATABASE_URL="sqlite:///./app.db"
# DATABASE_URL="postgresql://user:password@localhost:5432/saas_db"

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
